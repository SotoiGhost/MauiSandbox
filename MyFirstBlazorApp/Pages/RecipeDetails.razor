@page "/recipe/{RecipeId:int}"

@code {
    [Parameter]
    public int RecipeId { get; set; }

    private Recipe selectedRecipe;

    protected override void OnParametersSet()
    {
        selectedRecipe = recipes.FirstOrDefault(r => r.Id == RecipeId);

        if (selectedRecipe == null) {
            // Handle case where recipe is not found, e.g., redirect or show an error
            Console.WriteLine($"Recipe with ID {RecipeId} not found.");
        }
    }

    List<Recipe> recipes = new List<Recipe>
    {
        new Recipe { Id = 1, Name = "Spaghetti", Description = "Classic Italian pasta dish." },
        new Recipe { Id = 2, Name = "Tacos", Description = "Mexican dish with folded tortillas." },
        new Recipe { Id = 3, Name = "Sushi", Description = "Japanese dish of vinegared rice and seafood." }
    };
}

@if (selectedRecipe != null) {
    <h3>@selectedRecipe.Name</h3>
    <p>@selectedRecipe.Description</p>
} else {
    <p>Recipe not found.</p>
}
