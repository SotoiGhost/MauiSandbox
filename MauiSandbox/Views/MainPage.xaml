<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiSandbox.Models"
             xmlns:viewModels="clr-namespace:MauiSandbox.ViewModels"
             x:Class="MauiSandbox.Views.MainPage"
             x:DataType="viewModels:CarListViewModel"
             Title="{Binding Title}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="5"
          RowDefinitions="*,Auto">
        <RefreshView Grid.ColumnSpan="2"
                     Grid.RowSpan="2"
                     Command="{Binding GetCarsListCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Cars}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Car">
                        <Grid Padding="10">
                            <Border HeightRequest="90">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CarListViewModel}}, Path=GetCarDetailsCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Padding="10"
                                                       Spacing="5">
                                    <Label Text="{Binding Make}"/>
                                    <Label Text="{Binding Model}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Button
            Grid.Column="1"
            Grid.Row="1"
            Margin="24"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="50"
            Text="+"
            FontSize="25"
            Command="{Binding GetCarsListCommand}"/>
    </Grid>
</ContentPage>
